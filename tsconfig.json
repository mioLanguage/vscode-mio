{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"outDir": "out",
		"rootDir": "src",
		"composite": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"sourceMap": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "out"]
}